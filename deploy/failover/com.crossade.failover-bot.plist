<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ЗАПАСНОЙ БОТ на маке. Сам не стартует: его включает и гасит надзиратель. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crossade.failover-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>export PATH=$HOME/.nvm/versions/node/v22.23.2/bin:/opt/homebrew/bin:$PATH; cd $HOME/Desktop/crossade-deck/bot &amp;&amp; exec node --env-file=.env --import tsx src/index.ts</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/tmp/crossade-failover-bot.log</string>
  <key>StandardErrorPath</key><string>/tmp/crossade-failover-bot.log</string>
</dict>
</plist>
