{
  "name": "game-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A kit for assembling tabletop games. Slice 1: Node and Root.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "storybook": "npm run dev",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:catalog": "storybook build",
    "test:e2e": "playwright test",
    "dev:plain": "storybook dev -p 9567"
  },
  "devDependencies": {
    "@game-presets/cards": "*",
    "@game-presets/dice": "*",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-controls": "^8.6.18",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/blocks": "^8.6.18",
    "@storybook/html": "^8.6.14",
    "@storybook/html-vite": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "types": "./src/index.ts",
  "module": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./pixi": {
      "development": "./src/render/pixi.ts",
      "import": "./src/render/pixi.ts"
    }
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  }
}
