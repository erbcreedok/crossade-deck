{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The catalog consumes preset add-ons (`@game-presets/*`) by name; this makes tsc resolve them
    // through their `development` export condition to `src`, so no add-on needs a build to be documented.
    "customConditions": ["development"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    // The catalog's words are JSON files: a translator is handed a file, not a source tree.
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", ".storybook/**/*", "e2e", "playwright.config.ts"]
}
